{
  // sdk.wolvy.net: files only, no Worker code. A request for a file never runs a Worker,
  // so it is not counted or billed as a Worker request. Do not add "main" here.
  "name": "wolvy-sdk",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "sdk.wolvy.net", "custom_domain": true }]
}
