{
  "name": "wolvy-sdk",
  "private": true,
  "description": "The files served at sdk.wolvy.net, and the npm packages @wolvy/player and @wolvy/player-react",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/player",
    "packages/player-react"
  ],
  "scripts": {
    "release": "node scripts/release.mjs",
    "check": "node scripts/release.mjs --check",
    "test": "node --test \"test/*.test.mjs\"",
    "deploy": "node scripts/release.mjs --check && npx wrangler deploy"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "typescript-7": "npm:typescript@^7.0.2"
  }
}
