{
  "name": "@wolvy/player-react",
  "version": "1.0.0",
  "description": "A React component for the Wolvy video player: the embed iframe with the right attributes, event props such as onProgress, and the player object through a ref or a hook.",
  "license": "Apache-2.0",
  "author": "Wolvy (https://wolvy.net)",
  "homepage": "https://docs.wolvy.net/player-api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wolvy-Media-Hub/Wolvy-SDK.git",
    "directory": "packages/player-react"
  },
  "keywords": [
    "wolvy",
    "video",
    "player",
    "drm",
    "react",
    "iframe",
    "embed"
  ],
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "index.d.cts"
  ],
  "sideEffects": false,
  "dependencies": {
    "@wolvy/player": "^1.0.0"
  },
  "peerDependencies": {
    "@types/react": ">=16.8.0",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/release.mjs --publish"
  },
  "publishConfig": {
    "access": "public"
  }
}
